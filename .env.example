# Settings for the website (copy to .env.local for local development).
#
# IMPORTANT: never put API keys in this file. Anything starting with VITE_
# is copied into the public website and can be read by any visitor.
# API keys belong only in server/.env (see server/.env.example).

# Address of the backend server that holds the API keys.
# Locally you can leave this out: the site uses http://localhost:3001.
# For the live site, set it as a GitHub repository variable (not a secret file).
VITE_API_PROXY_URL=http://localhost:3001

# Development mode
VITE_DEBUG=false
