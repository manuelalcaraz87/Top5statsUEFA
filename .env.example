# Football Data API
# Get your token at: https://www.football-data.org/client/register
VITE_FD_TOKEN=your_football_data_token_here

# API Football (RapidAPI)
# Get your token at: https://rapidapi.com/api-sports/api/api-football
VITE_AF_TOKEN=your_api_football_token_here

# Backend Proxy Server (for production)
VITE_API_PROXY_URL=http://localhost:3001

# Development mode
VITE_DEBUG=false
