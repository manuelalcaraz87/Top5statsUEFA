# Backend Server
PORT=3001
NODE_ENV=development

# API Tokens (keep these secure, never commit to repo)
FD_TOKEN=your_football_data_token_here
AF_TOKEN=your_api_football_token_here

# Sportmonks Football API (Starter plan)
# Get your token at: https://www.sportmonks.com/
# Powers live defender/goalkeeper stats (tackles, interceptions, clearances,
# saves, clean sheets, rating, minutes played).
SM_TOKEN=your_sportmonks_token_here

# X.com (Twitter) API v2 Bearer Token — used to pull posts from league,
# club, player and commentator accounts for the Social Feed / Trending section.
# Get one at: https://developer.twitter.com/en/portal/dashboard
X_BEARER_TOKEN=your_x_api_bearer_token_here

# How often (minutes) to poll X.com for new posts.
SOCIAL_REFRESH_MINUTES=5

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Caching
CACHE_TTL_MINUTES=60
