# Backend Server
PORT=3001
NODE_ENV=development

# API Tokens (keep these secure, never commit to repo)
FD_TOKEN=your_football_data_token_here

# X.com (Twitter) API v2 Bearer Token — used to pull posts from league,
# club, player and commentator accounts for the Social Feed / Trending section.
# Get one at: https://developer.twitter.com/en/portal/dashboard
X_BEARER_TOKEN=your_x_api_bearer_token_here

# API-Football (v3) key — used for the live match list at /api/live; without it that list stays off.
AF_TOKEN=your_api_football_key_here

# Most API-Football calls allowed per UTC day; past this the live list stays off until midnight UTC.
AF_DAILY_BUDGET=3000

# How often (minutes) to poll X.com for new posts.
SOCIAL_REFRESH_MINUTES=5

# CORS Settings
CORS_ORIGIN=http://localhost:5173

# Caching (minutes). These can only make caching longer, never shorter.
# football-data.org: minimum 5.
FD_CACHE_TTL_MINUTES=5
